{
  "name": "Spectre mega-objects",
  "description": "Boris K. Horvat's grammar for the mega-objects of the Spectre tiling: MA(n) <- MA(n-1) & 3*MC(n-1), MC(n) <- MC(n-1) & 3*PA(n-1), PA(n) <- PA(n-1) & 2*MA(n). The counting is his and is checked: the tile counts come out 1, 4, 25, 136 for MA, 1, 7, 37 for MC and 2, 10, 60, 332 for PA, matching the figures on his own pages. The geometry is a first fit, not his: the turn angles and the anchors below place three arms at 120 degrees and the palindrome's two arms opposite each other, which is what his pictures show, but the exact attachment points are open. Change the numbers, redraw, compare with the pictures.",

  "shapes": {
    "star": {
      "outline": [[0, 0], [1, 0], [1.5, 0.866025], [1, 1.732051], [0, 1.732051], [-0.5, 0.866025]],
      "anchors": [[0.5, 0.866025], [1.5, 0.866025], [0, 1.732051], [-0.5, 0.866025]]
    },
    "pair": {
      "outline": [[0, 0], [1, 0], [1.5, 0.866025], [1, 1.732051], [0, 1.732051], [-0.5, 0.866025],
                  [-1.5, 0.866025], [-2, 0], [-1.5, -0.866025], [-0.5, -0.866025]],
      "anchors": [[-0.5, 0.433013], [1.5, 0.866025], [0, 1.732051], [-2, 0]]
    }
  },

  "rules": {
    "MA": {
      "base": "star",
      "parts": [
        {"symbol": "MA", "generation": -1, "turn": 0,   "anchor": 0, "onto": 0},
        {"symbol": "MC", "generation": -1, "turn": 0,   "anchor": 0, "onto": 1, "after": 0},
        {"symbol": "MC", "generation": -1, "turn": 120, "anchor": 0, "onto": 2, "after": 0},
        {"symbol": "MC", "generation": -1, "turn": 240, "anchor": 0, "onto": 3, "after": 0}
      ],
      "anchors": [
        {"part": 0, "anchor": 0},
        {"part": 1, "anchor": 1},
        {"part": 2, "anchor": 1},
        {"part": 3, "anchor": 1}
      ]
    },

    "MC": {
      "base": "star",
      "parts": [
        {"symbol": "MC", "generation": -1, "turn": 0,   "anchor": 0, "onto": 0},
        {"symbol": "PA", "generation": -1, "turn": 0,   "anchor": 0, "onto": 1, "after": 0},
        {"symbol": "PA", "generation": -1, "turn": 120, "anchor": 0, "onto": 2, "after": 0},
        {"symbol": "PA", "generation": -1, "turn": 240, "anchor": 0, "onto": 3, "after": 0}
      ],
      "anchors": [
        {"part": 0, "anchor": 0},
        {"part": 1, "anchor": 1},
        {"part": 2, "anchor": 1},
        {"part": 3, "anchor": 1}
      ]
    },

    "PA": {
      "seed": [
        {"symbol": "star", "generation": 0, "turn": 0,   "anchor": 0, "onto": 0},
        {"symbol": "star", "generation": 0, "turn": 180, "anchor": 0, "onto": 1, "after": 0}
      ],
      "parts": [
        {"symbol": "PA", "generation": -1, "turn": 0,   "anchor": 0, "onto": 0},
        {"symbol": "MA", "generation": 0,  "turn": 0,   "anchor": 0, "onto": 1, "after": 0},
        {"symbol": "MA", "generation": 0,  "turn": 180, "anchor": 0, "onto": 2, "after": 0}
      ],
      "anchors": [
        {"part": 0, "anchor": 0},
        {"part": 1, "anchor": 1},
        {"part": 1, "anchor": 2}
      ]
    }
  }
}
